# ---------------------------------------------------------
# Codeyoung Trial Class Booking System — Server Environment
# ---------------------------------------------------------
# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/codeyoung-trial-booking

# Port the Express API listens on
PORT=5000

# Frontend origin allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# Base URL used when generating simulated meeting links
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------
# Email (optional in development)
# ---------------------------------------------------------
# If SMTP_HOST / SMTP_USER / SMTP_PASSWORD are left blank,
# the app will NOT crash — it logs email content to the
# console instead of sending it. This lets you run and
# test the full booking flow without any email provider.
#
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-gmail-address@gmail.com
#   SMTP_PASSWORD=your-16-character-app-password   (NOT your normal Gmail password)
#   EMAIL_FROM="Codeyoung Trial Classes" <your-gmail-address@gmail.com>
#
# Gmail App Passwords require 2-Step Verification enabled on the
# Google account: https://myaccount.google.com/apppasswords

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
